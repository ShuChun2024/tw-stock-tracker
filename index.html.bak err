<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101827">
<title>台股分析儀表板</title>

<style>
:root{
  color-scheme:dark;
  --bg:#101827;
  --panel:#1b2535;
  --panel2:#111a29;
  --border:#344155;
  --text:#edf2f8;
  --muted:#9aa8ba;
  --green:#35d07f;
  --red:#ff6574;
  --yellow:#f4c95d;
  --blue:#66aaff;
  --orange:#ffad5c;
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    "Microsoft JhengHei",
    sans-serif;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:16px;
}

h1{
  margin:0 0 6px;
  font-size:24px;
}

.subtitle{
  color:var(--muted);
  font-size:13px;
  margin-bottom:16px;
}

.toolbar{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:14px;
}

button{
  border:1px solid var(--border);
  background:#202c40;
  color:var(--text);
  border-radius:8px;
  padding:8px 12px;
  cursor:pointer;
}

button:hover{
  background:#29374d;
}

button.active{
  background:#315a88;
}

.status{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:10px;
  padding:10px 12px;
  margin-bottom:14px;
  font-size:13px;
  color:var(--muted);
}

.stock-list{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.stock-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:12px;
  padding:14px;
}

.stock-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
}

.stock-title{
  min-width:0;
}

.stock-code{
  font-size:20px;
  font-weight:700;
}

.stock-name{
  color:var(--muted);
  font-size:14px;
  margin-top:2px;
}

.score-box{
  text-align:right;
  min-width:70px;
}

.score{
  font-size:25px;
  font-weight:700;
}

.score-label{
  font-size:11px;
  color:var(--muted);
}

.score-good{
  color:var(--green);
}

.score-mid{
  color:var(--yellow);
}

.score-bad{
  color:var(--red);
}

.metrics{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:12px;
}

.metric{
  background:var(--panel2);
  border-radius:9px;
  padding:10px;
}

.metric-label{
  color:var(--muted);
  font-size:12px;
  margin-bottom:4px;
}

.metric-value{
  font-size:16px;
  font-weight:600;
}


/* ============================================================
   三大法人摘要
   ============================================================ */

.chip-title{
  margin-top:12px;
  margin-bottom:7px;
  font-size:13px;
  font-weight:600;
}

.chip-summary{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}

.chip-item{
  background:var(--panel2);
  border-radius:9px;
  padding:9px 8px;
  min-width:0;
}

.chip-label{
  color:var(--muted);
  font-size:11px;
  margin-bottom:4px;
}

.chip-value{
  font-size:14px;
  font-weight:600;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.chip-sub{
  margin-top:3px;
  font-size:10px;
  color:var(--muted);
}

.chip-positive{
  color:var(--green);
}

.chip-negative{
  color:var(--red);
}

.chip-neutral{
  color:var(--text);
}


/* ============================================================
   三大法人詳細
   ============================================================ */

.institutional-summary{
  padding:8px 10px;
  background:#182336;
  border-radius:7px;
  margin-bottom:8px;
  font-size:12px;
}

.institutional-date{
  color:var(--muted);
  margin-bottom:3px;
}

.institutional-summary-text{
  font-weight:600;
}

.institutional-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}

.institutional-card{
  background:#111a29;
  border-radius:8px;
  padding:9px;
}

.institutional-card-title{
  font-size:13px;
  font-weight:600;
  margin-bottom:6px;
}

.institutional-card-row{
  display:flex;
  justify-content:space-between;
  gap:5px;
  padding:3px 0;
  font-size:11px;
  border-bottom:1px solid rgba(255,255,255,.04);
}

.institutional-card-row:last-child{
  border-bottom:none;
}

.institutional-card-label{
  color:var(--muted);
}

.institutional-card-value{
  text-align:right;
}


/* ============================================================
   評分
   ============================================================ */

.score-breakdown{
  margin-top:12px;
  background:var(--panel2);
  border-radius:9px;
  padding:10px;
}

.score-breakdown-title{
  font-size:13px;
  font-weight:600;
  margin-bottom:8px;
}

.score-row{
  display:grid;
  grid-template-columns:70px 1fr 65px;
  align-items:center;
  gap:8px;
  margin:6px 0;
  font-size:12px;
}

.score-bar{
  height:7px;
  background:#293548;
  border-radius:10px;
  overflow:hidden;
}

.score-fill{
  height:100%;
  border-radius:10px;
}

.score-number{
  text-align:right;
  color:var(--muted);
}


/* ============================================================
   技術分析
   ============================================================ */

.technical-summary{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:10px;
}

.technical-summary-item{
  background:var(--panel2);
  border-radius:8px;
  padding:8px;
}

.technical-summary-label{
  color:var(--muted);
  font-size:11px;
}

.technical-summary-value{
  font-size:13px;
  font-weight:600;
  margin-top:3px;
}

.technical-toggle{
  width:100%;
  margin-top:9px;
  text-align:center;
  font-size:12px;
}

.technical-details{
  display:none;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--border);
}

.technical-details.open{
  display:block;
}


/* ============================================================
   詳細資料
   ============================================================ */

.detail-toggle{
  width:100%;
  margin-top:9px;
  text-align:center;
  font-size:12px;
}

.details{
  display:none;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--border);
}

.details.open{
  display:block;
}

.detail-section{
  background:var(--panel2);
  border-radius:8px;
  padding:10px;
  margin-bottom:8px;
}

.detail-section-title{
  font-size:13px;
  font-weight:600;
  margin-bottom:8px;
}

.detail-row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:4px 0;
  font-size:12px;
  border-bottom:1px solid rgba(255,255,255,.04);
}

.detail-row:last-child{
  border-bottom:none;
}

.detail-label{
  color:var(--muted);
}

.detail-value{
  text-align:right;
}

.quality-warning{
  margin-top:10px;
  padding:8px 10px;
  border-radius:8px;
  background:rgba(244,201,93,.08);
  border:1px solid rgba(244,201,93,.25);
  color:var(--yellow);
  font-size:12px;
}

.no-data{
  color:var(--muted);
}

.error{
  color:var(--red);
}

.empty{
  text-align:center;
  color:var(--muted);
  padding:30px 10px;
}


/* ============================================================
   手機版
   ============================================================ */

@media(max-width:600px){

  .container{
    padding:10px;
  }

  h1{
    font-size:21px;
  }

  .stock-card{
    padding:12px;
  }

  .stock-code{
    font-size:18px;
  }

  .score{
    font-size:22px;
  }

  .metrics{
    gap:8px;
  }

  .metric{
    padding:8px;
  }

  .metric-value{
    font-size:14px;
  }

  .chip-summary{
    gap:6px;
  }

  .chip-item{
    padding:8px 6px;
  }

  .chip-value{
    font-size:12px;
  }

  .chip-sub{
    font-size:9px;
  }

  .institutional-grid{
    grid-template-columns:1fr;
  }

}
</style>
</head>

<body>

<div class="container">

  <h1>台股分析儀表板</h1>

  <div class="subtitle">
    基本面 × 籌碼面 × 技術面
  </div>

  <div class="toolbar">

    <button id="btnAll" class="active">
      全部
    </button>

    <button id="btnWatch">
      觀察清單
    </button>

    <button id="btnRefresh">
      重新整理
    </button>

  </div>

  <div id="status" class="status">
    載入資料中...
  </div>

  <div id="stockList" class="stock-list"></div>

</div>


<script>

/* ============================================================
   全域資料
   ============================================================ */

let analysisData = [];
let stockNames = {};
let watchlist = [];
let currentMode = "all";


/* ============================================================
   基本工具
   ============================================================ */

function validNumber(value){

  if(
    value === null ||
    value === undefined ||
    value === ""
  ){
    return false;
  }

  const n = Number(value);

  return Number.isFinite(n);
}


function numberText(value,digits=2){

  if(!validNumber(value)){
    return "—";
  }

  return Number(value).toFixed(digits);
}


function scoreClass(score){

  if(!validNumber(score)){
    return "";
  }

  if(score >= 70){
    return "score-good";
  }

  if(score >= 50){
    return "score-mid";
  }

  return "score-bad";
}


function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}


/* ============================================================
   股票名稱
   ============================================================ */

function getStockName(stockId,stock){

  if(stock && stock.stock_name){
    return stock.stock_name;
  }

  if(stock && stock.name){
    return stock.name;
  }

  if(stockNames[stockId]){
    return stockNames[stockId];
  }

  return "名稱待確認";
}


/* ============================================================
   取得三大法人資料
   ============================================================ */

function getInstitutional(s){

  return s.institutional || {};
}


function getInstitutionMetric(s,type){

  const institutional =
    getInstitutional(s);

  return institutional[type] || {
    latest_net_shares:null,
    latest_net_lots:null,
    net_5d_shares:null,
    net_5d_lots:null,
    net_20d_shares:null,
    net_20d_lots:null,
    consecutive_days:0,
    trend:"資料不足"
  };
}


/* ============================================================
   法人顯示文字
   ============================================================ */

function getNetText(metric){

  if(!metric){
    return "資料不足";
  }

  if(!validNumber(metric.latest_net_lots)){
    return "資料不足";
  }

  const value =
    Number(metric.latest_net_lots);

  if(value > 0){
    return "買超 " + numberText(value,1) + " 張";
  }

  if(value < 0){
    return "賣超 " + numberText(Math.abs(value),1) + " 張";
  }

  return "持平";
}


function getNetClass(metric){

  if(!metric){
    return "chip-neutral";
  }

  if(
    validNumber(metric.latest_net_lots)
  ){

    const value =
      Number(metric.latest_net_lots);

    if(value > 0){
      return "chip-positive";
    }

    if(value < 0){
      return "chip-negative";
    }
  }

  return "chip-neutral";
}


function getConsecutiveText(metric){

  if(
    !metric ||
    !validNumber(metric.consecutive_days) ||
    Number(metric.consecutive_days) === 0
  ){
    return "";
  }

  return "連續 " +
    Number(metric.consecutive_days) +
    " 日";
}


/* ============================================================
   三大法人摘要
   ============================================================ */

function renderInstitutionalSummary(s){

  const institutional =
    getInstitutional(s);

  const foreign =
    getInstitutionMetric(
      s,
      "foreign"
    );

  const trust =
    getInstitutionMetric(
      s,
      "trust"
    );

  const dealer =
    getInstitutionMetric(
      s,
      "dealer"
    );


  return `

    <div class="chip-title">
      三大法人籌碼
    </div>

    <div class="chip-summary">


      <div class="chip-item">

        <div class="chip-label">
          外資
        </div>

        <div class="chip-value ${getNetClass(foreign)}">
          ${escapeHtml(
            getNetText(foreign)
          )}
        </div>

        <div class="chip-sub">
          ${escapeHtml(
            getConsecutiveText(foreign)
          )}
        </div>

      </div>


      <div class="chip-item">

        <div class="chip-label">
          投信
        </div>

        <div class="chip-value ${getNetClass(trust)}">
          ${escapeHtml(
            getNetText(trust)
          )}
        </div>

        <div class="chip-sub">
          ${escapeHtml(
            getConsecutiveText(trust)
          )}
        </div>

      </div>


      <div class="chip-item">

        <div class="chip-label">
          自營商
        </div>

        <div class="chip-value ${getNetClass(dealer)}">
          ${escapeHtml(
            getNetText(dealer)
          )}
        </div>

        <div class="chip-sub">
          ${escapeHtml(
            getConsecutiveText(dealer)
          )}
        </div>

      </div>

    </div>

  `;
}


/* ============================================================
   三大法人詳細資料
   ============================================================ */

function renderInstitutionalDetailCard(
  title,
  metric
){

  return `

    <div class="institutional-card">

      <div class="institutional-card-title">
        ${escapeHtml(title)}
      </div>


      <div class="institutional-card-row">

        <div class="institutional-card-label">
          當日
        </div>

        <div class="institutional-card-value ${getNetClass(metric)}">
          ${escapeHtml(
            getNetText(metric)
          )}
        </div>

      </div>


      <div class="institutional-card-row">

        <div class="institutional-card-label">
          5日
        </div>

        <div class="institutional-card-value">

          ${
            validNumber(metric.net_5d_lots)

              ? (
                  Number(metric.net_5d_lots) > 0
                    ? "買超 "
                    : Number(metric.net_5d_lots) < 0
                      ? "賣超 "
                      : ""
                )
                +
                numberText(
                  Math.abs(
                    Number(metric.net_5d_lots)
                  ),
                  1
                )
                +
                (
                  Number(metric.net_5d_lots) !== 0
                    ? " 張"
                    : ""
                )

              : "—"
          }

        </div>

      </div>


      <div class="institutional-card-row">

        <div class="institutional-card-label">
          20日
        </div>

        <div class="institutional-card-value">

          ${
            validNumber(metric.net_20d_lots)

              ? (
                  Number(metric.net_20d_lots) > 0
                    ? "買超 "
                    : Number(metric.net_20d_lots) < 0
                      ? "賣超 "
                      : ""
                )
                +
                numberText(
                  Math.abs(
                    Number(metric.net_20d_lots)
                  ),
                  1
                )
                +
                (
                  Number(metric.net_20d_lots) !== 0
                    ? " 張"
                    : ""
                )

              : "—"
          }

        </div>

      </div>


      <div class="institutional-card-row">

        <div class="institutional-card-label">
          連續
        </div>

        <div class="institutional-card-value">
          ${
            validNumber(metric.consecutive_days)
              ? Number(metric.consecutive_days) + " 日"
              : "—"
          }
        </div>

      </div>


      <div class="institutional-card-row">

        <div class="institutional-card-label">
          方向
        </div>

        <div class="institutional-card-value">
          ${escapeHtml(
            metric.trend ||
            "資料不足"
          )}
        </div>

      </div>

    </div>

  `;
}


function renderInstitutionalDetails(s){

  const institutional =
    getInstitutional(s);

  const foreign =
    getInstitutionMetric(
      s,
      "foreign"
    );

  const trust =
    getInstitutionMetric(
      s,
      "trust"
    );

  const dealer =
    getInstitutionMetric(
      s,
      "dealer"
    );


  return `

    <div class="detail-section">

      <div class="detail-section-title">
        三大法人買賣超
      </div>


      <div class="institutional-summary">

        <div class="institutional-date">
          資料日期：
          ${escapeHtml(
            institutional.latest_date ||
            "—"
          )}
        </div>

        <div class="institutional-summary-text">
          ${escapeHtml(
            institutional.summary ||
            "資料不足"
          )}
        </div>

      </div>


      <div class="institutional-grid">

        ${renderInstitutionalDetailCard(
          "外資",
          foreign
        )}

        ${renderInstitutionalDetailCard(
          "投信",
          trust
        )}

        ${renderInstitutionalDetailCard(
          "自營商",
          dealer
        )}

      </div>

    </div>

  `;
}


/* ============================================================
   缺少資料
   ============================================================ */

function normalizeMissingItems(s){

  const map = {
    revenue:"營收",
    foreign_holding:"外資持股",
    institutional:"三大法人買賣超",
    technical:"技術面"
  };

  const result = [];

  if(Array.isArray(s.missing_items)){

    s.missing_items.forEach(
      item => {

        result.push(
          map[item] || item
        );

      }
    );
  }

  /*
   * 你的 analyzer.py 使用：
   *
   * data_quality.missing_items
   *
   * 因此這裡也支援該格式。
   */

  if(
    s.data_quality &&
    Array.isArray(
      s.data_quality.missing_items
    )
  ){

    s.data_quality.missing_items.forEach(
      item => {

        result.push(
          map[item] || item
        );

      }
    );
  }

  return [
    ...new Set(result)
  ];
}


/* ============================================================
   評分
   ============================================================ */

function renderScoreBreakdown(s){

  const revenue =
    s.revenue || {};

  const foreign =
    s.foreign_holding || {};

  const technical =
    s.technical || {};


  /*
   * 目前仍沿用原本評分：
   *
   * 基本面 40
   * 籌碼面 20
   * 技術面 40
   *
   * institutional 目前只做顯示，
   * 尚未納入評分。
   */

  const items = [

    {
      name:"基本面",
      score:revenue.score,
      max:40
    },

    {
      name:"籌碼面",
      score:foreign.score,
      max:20
    },

    {
      name:"技術面",
      score:technical.score,
      max:40
    }

  ];


  return `

    <div class="score-breakdown">

      <div class="score-breakdown-title">
        評分明細
      </div>


      ${items.map(item => {

        const score =
          validNumber(item.score)
            ? Number(item.score)
            : 0;

        const percent =
          Math.max(
            0,
            Math.min(
              100,
              score / item.max * 100
            )
          );


        return `

          <div class="score-row">

            <div>
              ${escapeHtml(item.name)}
            </div>

            <div class="score-bar">

              <div
                class="score-fill"
                style="
                  width:${percent}%;
                  background:
                    ${
                      percent >= 70
                        ? "var(--green)"
                        : percent >= 50
                          ? "var(--yellow)"
                          : "var(--red)"
                    };
                "
              ></div>

            </div>

            <div class="score-number">
              ${
                validNumber(item.score)
                  ? `${numberText(item.score,0)} / ${item.max}`
                  : "—"
              }
            </div>

          </div>

        `;

      }).join("")}

    </div>

  `;
}


/* ============================================================
   技術分析
   ============================================================ */

function renderTechnical(s){

  const technical =
    s.technical || {};

  const ma =
    technical.ma || {};

  const rsi =
    technical.rsi || {};

  const macd =
    technical.macd || {};

  const kdj =
    technical.kdj || {};


  return `

    <div class="technical-summary">


      <div class="technical-summary-item">

        <div class="technical-summary-label">
          技術訊號
        </div>

        <div class="technical-summary-value">
          ${escapeHtml(
            technical.signal ||
            technical.message ||
            "資料不足"
          )}
        </div>

      </div>


      <div class="technical-summary-item">

        <div class="technical-summary-label">
          RSI
        </div>

        <div class="technical-summary-value">

          ${
            validNumber(rsi.value)
              ? numberText(rsi.value,2)
              : validNumber(technical.rsi)
                ? numberText(technical.rsi,2)
                : "—"
          }

        </div>

      </div>


      <div class="technical-summary-item">

        <div class="technical-summary-label">
          MACD
        </div>

        <div class="technical-summary-value">
          ${escapeHtml(
            macd.signal ||
            technical.macd_signal ||
            "—"
          )}
        </div>

      </div>


      <div class="technical-summary-item">

        <div class="technical-summary-label">
          均線
        </div>

        <div class="technical-summary-value">
          ${escapeHtml(
            ma.signal ||
            technical.ma_signal ||
            "—"
          )}
        </div>

      </div>

    </div>


    <button
      class="technical-toggle"
