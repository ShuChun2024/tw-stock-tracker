function render(){

  const list =
    document.getElementById(
      "stockList"
    );

  let data =
    [...analysisData];


  if(currentMode === "watch"){

    data =
      data.filter(item => {

        const id =
          String(
            item.stock_id ||
            item.stock_code ||
            item.code ||
            ""
          );

        return watchlist.includes(id);

      });

  }


  if(data.length === 0){

    list.innerHTML = `
      <div class="empty">
        沒有符合條件的股票
      </div>
    `;

    return;
  }


  list.innerHTML =
    data.map(
      renderStockCard
    ).join("");
}


/* ============================================================
   stocks.json
   ============================================================ */

async function loadStockNames(){

  try{

    const response =
      await fetch(
        "./stocks.json?t=" +
        Date.now()
      );

    if(!response.ok){

      throw new Error(
        "stocks.json HTTP " +
        response.status
      );

    }


    const data =
      await response.json();


    if(Array.isArray(data)){

      data.forEach(item => {

        const id =
          String(
            item.stock_id ||
            item.code ||
            item.stock_code ||
            ""
          );

        const name =
          item.stock_name ||
          item.name ||
          "";

        if(id && name){

          stockNames[id] =
            name;

        }

      });

    }
    else if(
      data &&
      typeof data === "object"
    ){

      stockNames = data;

    }

  }
  catch(error){

    console.warn(
      "stocks.json 載入失敗：",
      error
    );

  }
}


/* ============================================================
   analysis.json
   ============================================================ */

async function loadAnalysis(){

  const status =
    document.getElementById(
      "status"
    );


  try{

    status.textContent =
      "正在載入分析資料...";


    const response =
      await fetch(
        "./analysis.json?t=" +
        Date.now()
      );


    if(!response.ok){

      throw new Error(
        "analysis.json HTTP " +
        response.status
      );

    }


    const data =
      await response.json();


    if(Array.isArray(data)){

      analysisData =
        data;

    }
    else if(
      data &&
      Array.isArray(data.stocks)
    ){

      analysisData =
        data.stocks;

    }
    else{

      analysisData = [];

    }


    const updateTime =
      data.update_time ||
      data.updated_at ||
      "";


    status.innerHTML =
      `股票數：${analysisData.length}` +
      (
        updateTime
          ? `　｜　更新時間：${escapeHtml(updateTime)}`
          : ""
      );


    render();

  }
  catch(error){

    console.error(error);


    status.innerHTML =
      `<span class="error">
        analysis.json 載入失敗：
        ${escapeHtml(
          error.message
        )}
      </span>`;


    document.getElementById(
      "stockList"
    ).innerHTML = `
      <div class="empty">
        無法取得分析資料
      </div>
    `;

  }
}


/* ============================================================
   觀察清單
   ============================================================ */

function loadWatchlist(){

  try{

    const raw =
      localStorage.getItem(
        "watchlist"
      );


    if(!raw){

      watchlist = [];

      return;
    }


    const data =
      JSON.parse(raw);


    if(Array.isArray(data)){

      watchlist =
        data.map(
          item => String(
            typeof item === "object"
              ? (
                  item.stock_id ||
                  item.code ||
                  item.stock_code ||
                  ""
                )
              : item
          )
        );

    }

  }
  catch(error){

    console.warn(
      "讀取 watchlist 失敗：",
      error
    );

    watchlist = [];

  }

}


