name: Run Stock Analysis
on:
  schedule:
    # 每天台灣時間晚上 9 點（UTC 13:00）
    - cron: '0 13 * * *'
  # 允許手動執行
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      # 1. 下載 GitHub Repository 程式碼
      - name: 檢查程式碼
        uses: actions/checkout@v4
      # 2. 設定 Python
      - name: 設定 Python 環境
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      # 3. 安裝必要套件
      - name: 安裝必要套件
        run: |
          python -m pip install --upgrade pip
          python -m pip install FinMind pandas requests
      # 4. 更新股票名稱資料
      - name: 更新股票名稱資料
        run: python update_stocks.py
      # 5. 執行股票分析
      - name: 執行選股分析
        run: python main.py
      # 6. 檢查輸出檔案與 JSON 格式
      - name: 檢查分析結果
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          for filename in ["stocks.json", "analysis.json"]:
              path = Path(filename)
              if not path.exists():
                  raise FileNotFoundError(f"找不到輸出檔案：{filename}")
              with path.open("r", encoding="utf-8") as f:
                  data = json.load(f)
              print(f"{filename}：JSON 格式正常")
              if filename == "analysis.json":
                  if not isinstance(data.get("stocks"), list):
                      raise ValueError("analysis.json 缺少有效的 stocks 陣列")
                  print("更新時間：", data.get("update_time"))
                  print("股票數量：", data.get("stock_count"))
          PY
      # 7. 將產生的資料提交回 GitHub
      - name: 保存股票分析資料
        run: |
          git config --local user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add analysis.json stocks.json
          # 有產生 log 檔案才加入
          if [ -f stock_analysis.log ]; then
            git add -f stock_analysis.log
          fi
          # 有變更才提交及推送
          if ! git diff --cached --quiet; then
            git commit -m "更新股票分析資料 [skip ci]"
            git push
          else
            echo "資料沒有變更，不需要提交"
          fi
