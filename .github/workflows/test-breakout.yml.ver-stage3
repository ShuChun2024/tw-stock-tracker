name: Test Breakout Strategy

on:
  workflow_dispatch:

  push:
    branches:
      - main
    paths:
      - "breakout.py"
      - "test_breakout.py"
      - "test_breakout_stage2.py"
      - "test_breakout_stage3.py"
      - ".github/workflows/test_breakout.yml"

  pull_request:
    branches:
      - main
    paths:
      - "breakout.py"
      - "test_breakout.py"
      - "test_breakout_stage2.py"
      - "test_breakout_stage3.py"
      - ".github/workflows/test_breakout.yml"

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      # ------------------------------------------------------
      # 1. 下載專案
      # ------------------------------------------------------

      - name: Checkout repository
        uses: actions/checkout@v4

      # ------------------------------------------------------
      # 2. 設定 Python
      # ------------------------------------------------------

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      # ------------------------------------------------------
      # 3. 安裝基本工具
      # ------------------------------------------------------

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip

      # ------------------------------------------------------
      # 4. Python 語法檢查
      # ------------------------------------------------------

      - name: Check Python syntax
        run: |
          python -m py_compile breakout.py
          python -m py_compile test_breakout.py
          python -m py_compile test_breakout_stage2.py
          python -m py_compile test_breakout_stage3.py

      # ------------------------------------------------------
      # 5. Stage 1：原始狀態管理測試
      # ------------------------------------------------------

      - name: Run Stage 1 tests
        run: |
          python -m unittest -v test_breakout

      # ------------------------------------------------------
      # 6. Stage 2A：資料完整性測試
      # ------------------------------------------------------

      - name: Run Stage 2A tests
        run: |
          python -m unittest -v test_breakout_stage2

      # ------------------------------------------------------
      # 7. Stage 3：交易資料結構測試
      # ------------------------------------------------------

      - name: Run Stage 3 trade schema tests
        run: |
          python -m unittest -v test_breakout_stage3
