name: Test Investor Conference v11.1
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  test-conference:
    runs-on: ubuntu-latest
    steps:
      # ============================================================
      # 1. Checkout
      # ============================================================
      - name: Checkout repository
        uses: actions/checkout@v4
      # ============================================================
      # 2. Setup Python
      # ============================================================
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      # ============================================================
      # 3. Install dependencies
      # ============================================================
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests
          pip install beautifulsoup4
          pip install python-docx
          pip install pdfplumber
      # ============================================================
      # 4. 確認實際執行的 test_conference.py
      # ============================================================
      - name: Verify test script
        run: |
          echo "========================================"
          echo "Current directory"
          echo "========================================"
          pwd
          echo ""
          echo "========================================"
          echo "Repository files"
          echo "========================================"
          ls -lah
          echo ""
          echo "========================================"
          echo "test_conference.py location"
          echo "========================================"
          find . -name "test_conference.py" -print
          echo ""
          echo "========================================"
          echo "test_conference.py first 40 lines"
          echo "========================================"
          sed -n '1,40p' test_conference.py
      # ============================================================
      # 5. 執行 v11.1
      # ============================================================
      - name: Run investor conference test v11.1
        run: |
          python test_conference.py
      # ============================================================
      # 6. 確認程式產生的檔案
      # ============================================================
      - name: Check v11.1 output files
        if: always()
        run: |
          echo "========================================"
          echo "Current directory"
          echo "========================================"
          pwd
          echo ""
          echo "========================================"
          echo "Root directory files"
          echo "========================================"
          ls -lah
          echo ""
          echo "========================================"
          echo "v11.1 output files"
          echo "========================================"
          if [ -f "twse_conference_v11_1_result.json" ]; then
            echo "FOUND: twse_conference_v11_1_result.json"
            ls -lh twse_conference_v11_1_result.json
          else
            echo "NOT FOUND: twse_conference_v11_1_result.json"
          fi
          if [ -f "twse_conference_v11_1_sessions.txt" ]; then
            echo "FOUND: twse_conference_v11_1_sessions.txt"
            ls -lh twse_conference_v11_1_sessions.txt
          else
            echo "NOT FOUND: twse_conference_v11_1_sessions.txt"
          fi
          if [ -d "twse_conference_v11_1_files" ]; then
            echo "FOUND: twse_conference_v11_1_files/"
            find twse_conference_v11_1_files -maxdepth 2 -type f -print
          else
            echo "NOT FOUND: twse_conference_v11_1_files/"
          fi
          echo ""
          echo "========================================"
          echo "Search entire workspace"
          echo "========================================"
          find . -type f \( \
            -name "twse_conference_v11_1_result.json" -o \
            -name "twse_conference_v11_1_sessions.txt" \
          \) -print
      # ============================================================
      # 7. 顯示 JSON / TXT 前幾行
      # ============================================================
      - name: Preview v11.1 reports
        if: always()
        run: |
          echo "========================================"
          echo "JSON preview"
          echo "========================================"
          if [ -f "twse_conference_v11_1_result.json" ]; then
            sed -n '1,80p' twse_conference_v11_1_result.json
          else
            echo "JSON file not found"
          fi
          echo ""
          echo "========================================"
          echo "TXT preview"
          echo "========================================"
          if [ -f "twse_conference_v11_1_sessions.txt" ]; then
            sed -n '1,120p' twse_conference_v11_1_sessions.txt
          else
            echo "TXT file not found"
          fi
      # ============================================================
      # 8. Upload Artifact
      # ============================================================
      - name: Upload v11.1 test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: conference-event-detail-v11-1
          path: |
            twse_conference_v11_1_result.json
            twse_conference_v11_1_sessions.txt
            twse_conference_v11_1_files/
          if-no-files-found: warn
          retention-days: 7
